                {
                  "type": "text",
                  "id": "swAt0",
                  "content": "01  交付與上線治理",
                  "fill": "#000000",
                  "fontSize": 12,
                  "fontWeight": "900",
                  "textGrowth": "auto"
                },
                {
                  "type": "text",
                  "id": "swAbd0",
                  "content": "負責超過 50 款遊戲前端的持續整合與多環境上線；將部署、備份驗證、版本對齊與上線報告收斂成儀表與腳本，降低人為漏步與環境落差，讓「是否已上線、上到哪一版」可被團隊一致確認。",
                  "fill": "#525252",
                  "fontSize": 13,
                  "fontWeight": "400",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "lineHeight": 1.55
                }
